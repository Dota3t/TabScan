<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TabScan.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TabScan"
    Title="TabScan">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="WpisyPAge"
        ContentTemplate="{DataTemplate local:WpisyPage}"
        Route="WpisyPAge" />
    <ShellContent
        Title="SkanPAge"
        ContentTemplate="{DataTemplate local:SkanPage}"
        Route="SkanPage" />

</Shell>
